// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"

}

model User {
  id                 Int                @id @default(autoincrement())
  email              String             @unique
  name               String?
  password           String?
  role               UserRole           @default(ADMIN)
  company            Company            @relation(fields: [companyId], references: [id])
  selectedLocations  SelectedLocation[]
  companyId          Int
  location           Location?          @relation(fields: [locationId], references: [id])
  locationId         Int?
  createdAt          DateTime           @default(now())
  updateTime         DateTime           @updatedAt
  isArchived         Boolean            @default(false)
  // Login rate limit (lib/access/loginThrottle): wrong passwords in the
  // current 15-minute run, when that run started, and — after 5 — the
  // lock's end. Reset by a successful sign-in. Written only by
  // AppService.verifyCredentials.
  failedLoginCount   Int                @default(0)
  firstFailedLoginAt DateTime?
  lockedUntil        DateTime?
  // What the owner has granted this MANAGER (see UserPermission). Never
  // read for an ADMIN.
  permissions        UserPermission[]   @relation("UserPermissions")
  // Grants this user (an owner) has given — for "granted by".
  permissionGrants   UserPermission[]   @relation("PermissionGrants")
  // Voids this user made (OrderVoid.voidedBy) — history, kept (SetNull)
  // if the user is removed.
  orderVoids         OrderVoid[]        @relation("OrderVoids")
}

model Company {
  id             Int            @id @default(autoincrement())
  name           String
  address        String?
  users          User[]
  locations      Location[]
  menuCategories MenuCategory[]
  createdAt      DateTime       @default(now())
  updateTime     DateTime       @updatedAt
  isArchived     Boolean        @default(false)
}

model Table {
  id               Int            @id @default(autoincrement())
  name             String
  // Storage KEY of this table's QR PNG ("table/5-1730000000000.png"),
  // never a URL — the URL is built when it is sent out, so an address or
  // storage-provider change never touches the database. Stored (not drawn
  // on demand) because the PNG carries the owner's per-table logo, which
  // is kept nowhere else. null = no image yet — never "".
  qrImageKey       String?
  location         Location       @relation(fields: [locationId], references: [id])
  locationId       Int
  OrderSessions    OrderSession[]
  orders           Order[]
  // The key printed in this Counter's QR URL right now (e.g.
  // /counter?tableId=5&key=awzy) — checked once at scan time by
  // OrderSessionService.resolveCounterQrScan. Regenerating it (via
  // TableService.rotateCounterKey, which also reprints the QR image)
  // invalidates every previously-printed copy of this QR at once.
  // Only meaningful when isCounter is true; null for regular tables.
  counterAccessKey String?
  // Which OrderSession this table's QR currently resolves to — null
  // means the table is free for a brand-new order/group. Set by
  // TableDraftService.submitDraft the moment a round is created, and
  // left pointing at a now-terminal (PAID/COMPLETED/CANCELLED) session
  // until the next round supersedes it — see
  // OrderSessionService.getActiveRoundForTable, which treats a
  // terminal session behind this pointer the same as no active round.
  // Plain scalar, not a formal Prisma relation — OrderSessions above
  // already covers the Table<->OrderSession link via tableId, and a
  // second named relation here isn't needed since nothing navigates
  // table.activeSession directly (the Service looks it up by id).
  activeSessionId  Int?
  // Bumped by OrderSessionApprovalService.markSessionsPaid whenever
  // this table gets settled — see the per-customer draft design's
  // "invalidate old contributor tokens on payment" follow-up. Every
  // CONTRIBUTOR_TOKEN_COOKIE entry embeds the epoch it was minted
  // under (see contributorToken.ts); once this counter moves past
  // that, the token reads as stale even though the cookie itself is
  // still sitting in the customer's browser, forcing them back to
  // plain browsing until they scan the table's QR again (which always
  // mints a token under the table's CURRENT epoch). Table QR only —
  // Counter sessions never read this field, since each Counter phone
  // is already its own independent session with nothing to "reopen".
  contributorEpoch Int            @default(0)
  isCounter        Boolean?
  createdAt        DateTime       @default(now())
  updateTime       DateTime       @updatedAt
  isArchived       Boolean        @default(false)

  @@map("tables") // Avoids any issues with database reserved words
}

model Location {
  id                             Int                             @id @default(autoincrement())
  name                           String
  tables                         Table[]
  selectedLocations              SelectedLocation[]
  menuStocks                     MenuStock[]
   managers                       User[] 
  company                        Company                         @relation(fields: [companyId], references: [id])
  archivedAt                     DateTime?
  companyId                      Int
  createdAt                      DateTime                        @default(now())
  updateTime                     DateTime                        @updatedAt
  isArchived                     Boolean                         @default(false)
  // When true, anyone with this location's online menu link can VIEW
  // the menu without scanning a QR code. Ordering always still needs the
  // QR (table/counter token). Off by default.
  onlineMenuEnabled              Boolean                         @default(false)
  disableLocationMenus           DisableLocationMenus[]
  disableLocationMenuCategories DisableLocationMenuCategories[]
  orderSessions                  OrderSession[]
  bills                          Bill[]
  // Per-day menu view totals at this location (Reports).
  menuViewDailies                MenuViewDaily[]
}

model SelectedLocation {
  id         Int      @id @default(autoincrement())
  location   Location @relation(fields: [locationId], references: [id])
  locationId Int
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  createdAt  DateTime @default(now())
  updateTime DateTime @updatedAt
  isArchived Boolean  @default(false)
  @@unique([userId])
}

model Menu {
  id                   Int                    @id @default(autoincrement())
  name                 String
  // Myanmar name (customer screens, Myanmar chosen); null = not
  // translated yet — the English `name` (required) is shown instead.
  nameMy               String?
  price                Int
  description          String?
  // Myanmar description; null = show the English `description`.
  descriptionMy        String?
  menuMenuCategory     MenuMenuCategory[]
  menuAddonCategories  MenuAddonCategories[]
  disableLocationMenus DisableLocationMenus[]
  menuStocks           MenuStock[]
  // Up to 3 photos, in `position` order (MenuImage).
  menuImages           MenuImage[]
  orders               Order[]
  // How many customers opened this menu's detail, per day and location
  // (MenuViewDaily), and the dedupe rows behind it (MenuViewSeen).
  menuViewDailies      MenuViewDaily[]
  menuViewSeens        MenuViewSeen[]
  createdAt            DateTime               @default(now())
  updateTime           DateTime               @updatedAt
  isArchived           Boolean                @default(false)
}

/**
 * A menu's photos — up to 3, shown in `position` order (0 = the main
 * photo on the menu card). `imageKey` is the storage KEY
 * ("menu/12-1730000000000.webp"), never a URL: the URL is built when it
 * is sent out, so an address or storage-provider change never touches
 * the database.
 * No companyId — like Menu's other children, it is scoped through the
 * menu (and the menu through its categories).
 * No onDelete: Cascade — MenuService.deleteMenu deletes these rows in
 * its own transaction and must read the keys first, to delete the files
 * after the commit (CLAUDE.md §7); a cascade would drop them silently.
 * position 0..2 can't be expressed here: Zod and the service enforce it.
 */
model MenuImage {
  id        Int      @id @default(autoincrement())
  menu      Menu     @relation(fields: [menuId], references: [id])
  menuId    Int
  imageKey  String
  // 0..2, continuous — the order the photos are shown in.
  position  Int
  createdAt DateTime @default(now())

  // One photo per slot per menu. Also serves menuId lookups (menuId is
  // the index's first column), so no separate @@index([menuId]).
  @@unique([menuId, position])
}

model MenuStock {
  id                 Int      @id @default(autoincrement())
  menu               Menu     @relation(fields: [menuId], references: [id])
  menuId             Int
  location           Location @relation(fields: [locationId], references: [id])
  locationId         Int
  quantity           Int      @default(0)
  isManuallyDisabled Boolean  @default(false)
  createdAt          DateTime @default(now())
  updateTime         DateTime @updatedAt
  isArchived         Boolean  @default(false)

  @@unique([menuId, locationId])
}

model MenuCategory {
  id                            Int                             @id @default(autoincrement())
  name                          String
  // Myanmar name (customer screens, Myanmar chosen); null = not
  // translated yet — the English `name` (required) is shown instead.
  nameMy                        String?
  company                       Company                         @relation(fields: [companyId], references: [id])
  companyId                     Int
  menuMenuCategory              MenuMenuCategory[]
  disableLocationMenuCategories DisableLocationMenuCategories[]
  createdAt                     DateTime                        @default(now())
  updateTime                    DateTime                        @updatedAt
  isArchived                    Boolean                         @default(false)
  // Company-wide display order, used everywhere categories are listed
  // (customer menu tabs, staff order screen, menu form, Backoffice list).
  // Lower = first; ties broken by id.
  sortOrder                     Int                             @default(0)

  @@index([companyId, sortOrder])
}

// join Table
model MenuMenuCategory {
  id             Int          @id @default(autoincrement())
  menuCategory   MenuCategory @relation(fields: [menuCategoryId], references: [id])
  menuCategoryId Int
  menu           Menu         @relation(fields: [menuId], references: [id])
  menuId         Int
  createdAt      DateTime     @default(now())
  updateTime     DateTime     @updatedAt
  isArchived     Boolean      @default(false)
}

model Addon {
  id              Int             @id @default(autoincrement())
  name            String
  // Myanmar name (customer screens, Myanmar chosen); null = not
  // translated yet — the English `name` (required) is shown instead.
  nameMy          String?
  price           Int
  addonCategory   AddonCategories @relation(fields: [addonCategoryId], references: [id])
  addonCategoryId Int
  OrdersAddons    OrdersAddon[]
  isAvailable     Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updateTime      DateTime        @updatedAt
  isArchived      Boolean         @default(false)
}

model AddonCategories {
  id                Int                   @id @default(autoincrement())
  name              String
  // Myanmar name (customer screens, Myanmar chosen); null = not
  // translated yet — the English `name` (required) is shown instead.
  nameMy            String?
  isRequired        Boolean               @default(false)
  addons            Addon[]
  menuAddonCategory MenuAddonCategories[]
  createdAt         DateTime              @default(now())
  updateTime        DateTime              @updatedAt
  isArchived        Boolean               @default(false)
}

model MenuAddonCategories {
  id              Int             @id @default(autoincrement())
  menu            Menu            @relation(fields: [menuId], references: [id])
  menuId          Int
  addonCategory   AddonCategories @relation(fields: [addonCategoryId], references: [id])
  addonCategoryId Int
  createdAt       DateTime        @default(now())
  updateTime      DateTime        @updatedAt
  isArchived      Boolean         @default(false)
}

model DisableLocationMenus {
  id         Int      @id @default(autoincrement())
  locationId Int      @map("locationsId") // Keeps compatibility with your existing field naming
  location   Location @relation(fields: [locationId], references: [id])
  menu       Menu     @relation(fields: [menuId], references: [id])
  menuId     Int
  createdAt  DateTime @default(now())
  updateTime DateTime @updatedAt
  isArchived Boolean  @default(false)
}

model DisableLocationMenuCategories {
  id             Int          @id @default(autoincrement())
  locationId     Int          @map("locationsId") // Keeps compatibility with your existing field naming
  location       Location     @relation(fields: [locationId], references: [id])
  menuCategory   MenuCategory @relation(fields: [menuCategoryId], references: [id])
  menuCategoryId Int
  createdAt      DateTime     @default(now())
  updateTime     DateTime     @updatedAt
  isArchived     Boolean      @default(false)
}

model Order {
  id               Int           @id @default(autoincrement())
  menuId           Int
  quantity         Int
  // Snapshot of Menu.price at the moment this line was added — never
  // re-read from Menu for totals, since a later price change on the
  // menu must not alter an already-placed order's line total.
  unitPrice        Int
  tableId          Int
  // Nullable — a "draft" line item (see the Table-QR per-customer draft
  // design) has no session yet: it's owned by (tableId, contributorToken)
  // alone until "Send to Kitchen" merges each customer's identical drafts
  // and attaches the rows to a freshly created OrderSession. A
  // Counter QR line item is never a draft — it gets orderSessionId set
  // immediately, same as before this change.
  orderSession     OrderSession? @relation(fields: [orderSessionId], references: [id])
  orderSessionId   Int?
  // Which customer's phone added this line (see the
  // CONTRIBUTOR_TOKEN_COOKIE design). Set on Table QR drafts AND kept on
  // the submitted Table lines (Send to Kitchen merges per customer and
  // copies it over), so each customer's own view can show "You" vs
  // "Customer 2" after Send. Edit/remove rights apply to DRAFTS only
  // (TableDraftService checks orderSessionId = null as well as the
  // token) — a submitted line is never editable. Never sent to the
  // client: the server turns it into { isMine, contributorNo } labels
  // first (lib/contributors.ts). Null on Counter and staff lines, and on
  // Table lines submitted before it was kept.
  contributorToken String?
  // Optional customer instruction for this one line item ("no onion",
  // "extra spicy") — item-level, not session-level. Null (never "")
  // when there's none. Drafts with different notes are deliberately
  // NOT merged by TableDraftService.submitDraft, so the note survives
  // Send to Kitchen.
  note             String?
  menu             Menu          @relation(fields: [menuId], references: [id])
  table            Table         @relation(fields: [tableId], references: [id])
  createdAt        DateTime      @default(now())
  updateTime       DateTime      @updatedAt
  isArchived       Boolean       @default(false)
  OrdersAddons     OrdersAddon[]
  // Voids taken off this line (OrderVoid) — append-only history.
  voids            OrderVoid[]

  // orderSessionId: serves every "lines of this session" read (Counter
  // cart, customer polling, Backoffice order list/detail, bill totals).
  // (tableId, orderSessionId): serves Table-QR draft reads, which filter
  // by table AND orderSessionId = null (getDraftItemsForTable,
  // submitDraft, the post-payment draft cleanup). tableId first so
  // table-only lookups can use it too. PostgreSQL does not auto-index
  // foreign keys, and this table keeps every line ever ordered.
  @@index([orderSessionId])
  @@index([tableId, orderSessionId])
  @@map("orders") // This fixes the Postgres "Order relation does not exist" issue by naming the table safely
}

// order id with addon id join table
model OrdersAddon {
  id        Int   @id @default(autoincrement())
  orderId   Int
  order     Order @relation(fields: [orderId], references: [id])
  addonId   Int
  addon     Addon @relation(fields: [addonId], references: [id])
  // Snapshot of Addon.price at the moment this line was added — never
  // re-read from Addon for totals, same reasoning as Order.unitPrice.
  unitPrice Int
}

/**
 * One receipt/order-group — ties multiple Order (line-item) rows
 * together into one customer-facing total, and is the one place
 * PAID/CANCELLED/etc. status is decided for the whole order.
 */
model OrderSession {
  id          Int         @id @default(autoincrement())
  // Opaque, unguessable identifier used as the cookie value for
  // Counter QR sessions — deliberately NOT the same as `id` (a plain
  // auto-increment int would let one customer's browser guess or
  // tamper into another customer's cookie/session by changing a
  // number). Table QR sessions don't need this since they're never
  // identified by a client-held credential in the first place.
  token       String      @unique @default(cuid())
  // Customer-facing label, e.g. "#A042". Generation scheme (daily-reset
  // vs global) still open — OrderSessionService.generateOrderNumber is
  // the one place to change it later.
  orderNumber String
  location    Location    @relation(fields: [locationId], references: [id])
  locationId  Int
  table       Table?      @relation(fields: [tableId], references: [id])
  tableId     Int?
  isCounter   Boolean     @default(false)
  status      ORDERSTATUS @default(CART)
  // Set the moment a customer submits from CART -> PENDING_APPROVAL;
  // cleared once a cashier accepts/rejects. OrderSessionService checks
  // this lazily on read (getSessionStatus) and in a batch sweep
  // (expireStaleApprovals) rather than needing a background job — any
  // session still PENDING_APPROVAL past this timestamp is treated as
  // timed out (the window is APPROVAL_WINDOW_MINUTES in
  // orderSession.service.ts).
  approvalExpiresAt DateTime?
  orders      Order[]
  createdAt   DateTime    @default(now())
  updateTime  DateTime    @updatedAt
  isArchived  Boolean     @default(false)
  // Bill grouping for "Order More" rounds — null means this session IS
  // the first round of its own bill; otherwise this holds the id of
  // that bill's first round (the "root"), so round 3 points at round
  // 1, not round 2. Set only by OrderSessionService.startNextRound.
  // Plain scalar, same style as Table.activeSessionId — no formal
  // relation. Counter QR only for now. Grouping
  // (groupSessionsForDisplay) uses this numeric id, NEVER `token` — a
  // secret session credential that must never appear in a group key
  // or URL.
  billSessionId Int?
  // Set only once this round is paid — points at the immutable Bill
  // record created at payment time. Null for every open/unpaid round,
  // and distinct from billSessionId above (which groups open Counter
  // rounds before any payment happens).
  bill          Bill?       @relation(fields: [billId], references: [id])
  billId        Int?
  // Why this round was cancelled — set only together with status
  // CANCELLED (see OrderSessionService.cancelSession, the one place
  // that writes either). Null for every non-cancelled row, and for
  // CANCELLED rows written before this column existed (old data is
  // left as-is, never backfilled).
  cancelReason  CancelReason?
  // Idempotency key for a browser-cart submit (Counter / Online carts
  // live in localStorage and reach the server only on submit). The
  // customer's browser generates it with crypto.randomUUID() for ONE
  // cart submission and sends it along; if a submission arrives with
  // an id that already exists, the server returns that existing order
  // instead of creating a second one — so a retry after a dropped
  // response can't double-order. Null for sessions not created from a
  // browser cart (Table QR rounds, staff orders, older data).
  // @unique allows many NULLs in PostgreSQL, so older rows need no
  // backfill.
  clientRequestId String? @unique
  // Who sent this round. CUSTOMER = a QR phone (Counter cart, Table
  // draft); STAFF = the Backoffice New Order screen. Rounds from before
  // this column read CUSTOMER (owner's decision) — the default fills
  // them in, so the migration needs no backfill.
  placedBy      PlacedBy    @default(CUSTOMER)
  // The cancellation record of a submitted round that ended REJECTED or
  // EXPIRED (see OrderCancellation). Relation field only — no column.
  cancellation  OrderCancellation?

  @@index([billSessionId])
  @@index([billId])
  // Every Order page query filters by location first, then by status
  // (e.g. getSessionsForLocation's PENDING_APPROVAL/PENDING/COOKING,
  // and the pending-approval lookups). PostgreSQL does not auto-index
  // foreign keys, so without this those reads scan the whole table,
  // which keeps growing with PAID history. Column order matters:
  // locationId first, so location-only lookups can use it too.
  @@index([locationId, status])
}

/**
 * One row per PAID bill — created at payment time, grouping the one or
 * more OrderSession rounds (see OrderSession.billSessionId/billId) that
 * were settled together. A Bill is an immutable money record: once
 * written it is never updated, so it deliberately has no updateTime/
 * isArchived, and no tableId/isCounter — table and channel are derived
 * by following bill.sessions back to their OrderSession(s) instead of
 * being duplicated here.
 */
model Bill {
  id         Int            @id @default(autoincrement())
  // Display/search label — the first round's orderNumber.
  billNumber String
  location   Location       @relation(fields: [locationId], references: [id])
  // Filter key for history — kept on Bill on purpose (not derived via
  // sessions) so location-scoped bill history doesn't have to join out
  // to OrderSession just to filter by location.
  locationId Int
  // Snapshot of what was charged.
  total      Int
  paidAt     DateTime
  createdAt  DateTime       @default(now())
  sessions   OrderSession[]

  @@index([locationId, paidAt])
}

/**
 * One row per SUBMITTED round that ended cancelled — REJECTED by the
 * cashier or EXPIRED (approval window passed). Never written for
 * UNSUBMITTED carts or for accepted rounds. OrderSessionService
 * .cancelSession is the only writer, in the same write that sets the
 * session CANCELLED. Rounds cancelled before this table existed simply
 * have no row (never backfilled). Kept off OrderSession on purpose, so
 * submit/accept code writes nothing extra. Lives and dies with its
 * session: no updateTime/isArchived, deleted with it.
 */
model OrderCancellation {
  id             Int           @id @default(autoincrement())
  orderSession   OrderSession  @relation(fields: [orderSessionId], references: [id], onDelete: Cascade)
  // @unique: at most one cancellation per round (and the only index
  // this table needs).
  orderSessionId Int           @unique
  // When the customer submitted the round. Nothing is written at submit
  // time, so cancelSession DERIVES this from the session just before
  // the cancel overwrites approvalExpiresAt (see lib/cancellation.ts)
  // and freezes it here.
  requestedAt    DateTime
  // When it ended. REJECTED: the moment the cashier tapped Reject.
  // EXPIRED: the approval deadline (approvalExpiresAt) — not the moment
  // a poll or sweep happened to notice it.
  decidedAt      DateTime
  // Why the cashier rejected it — set only on REJECTED rows; null for
  // EXPIRED.
  rejectReason   RejectReason?
  // The cashier's optional free-text note — ONLY when rejectReason is
  // OTHER (e.g. "coffee machine broken"). Null for every other reason,
  // for timeouts and for older rows (never backfilled). The app trims
  // it and stores an empty note as null; 120 characters is the hard
  // limit (enforced in Zod too). Written only by cancelSession, never
  // edited afterwards.
  note           String?       @db.VarChar(120)
  createdAt      DateTime      @default(now())
}

// Why staff voided (took back) items from an accepted, unpaid order —
// OrderVoid.reason.
enum VoidReason {
  CUSTOMER_CHANGED_MIND // The customer no longer wants it.
  WRONG_ITEM // Rung up or made by mistake.
  OTHER // Anything else — see OrderVoid.note.
}

/**
 * One void: staff took `quantity` of one order line back off an
 * accepted, unpaid order. Append-only history, in the same spirit as
 * OrderCancellation — written once, never edited. A line can be voided
 * more than once (each a row), never beyond its quantity.
 */
model OrderVoid {
  id            Int        @id @default(autoincrement())
  // The order line voided from. Its rows go with the line (Cascade) —
  // a line is only ever deleted with its draft or location, never once
  // it's on an accepted order.
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       Int
  // How many of that line this void removed (at least 1; the app checks
  // it never goes past what's left of the line).
  quantity      Int
  reason        VoidReason
  // Staff's optional free-text note — ONLY when reason is OTHER. The app
  // trims it and stores an empty note as null; 120 characters is the
  // hard limit (enforced in Zod too).
  note          String?    @db.VarChar(120)
  // Whether `quantity` went back into MenuStock (it wasn't made yet), or
  // not (already made — wasted).
  stockReturned Boolean
  // Who voided it — a live link while that user exists, for joining
  // ("voids by this person"). Cleared if the user is later removed
  // (SetNull), so removing a manager never deletes a void; the name
  // below is what keeps "who" on the record after that.
  voidedBy      User?      @relation("OrderVoids", fields: [voidedById], references: [id], onDelete: SetNull)
  voidedById    Int?
  // The staff member's display name (name, else email) copied at void
  // time — frozen like the rest of the row, never updated on a rename
  // and kept when the user is removed. Null on voids made before this
  // column existed (no name is made up for them).
  voidedByName  String?    @db.VarChar(120)
  createdAt     DateTime   @default(now())

  // orderId: a line's voids (bill, detail, reports). voidedById: "voids
  // by this person" and the SetNull on user removal. PostgreSQL does not
  // auto-index foreign keys.
  @@index([orderId])
  @@index([voidedById])
}

// Who sent a round — OrderSession.placedBy.
enum PlacedBy {
  CUSTOMER // A QR phone: the Counter cart or a Table draft.
  STAFF // The Backoffice New Order screen.
}

/**
 * How many customers opened a menu's detail, per shop day and location —
 * the totals Reports reads, so it never has to count raw view rows. One
 * row per (menu, location, day); `viewers` goes up by one the first time
 * a customer views that menu that day (MenuViewSeen decides "first").
 * `day` is a shop day string, not a timestamp, so a day is the shop's
 * day (Asia/Yangon) and never shifts with the server's clock.
 */
model MenuViewDaily {
  id         Int      @id @default(autoincrement())
  menu       Menu     @relation(fields: [menuId], references: [id])
  menuId     Int
  location   Location @relation(fields: [locationId], references: [id])
  locationId Int
  // Shop day "YYYY-MM-DD" (lib/shopDay, Asia/Yangon).
  day        String
  viewers    Int      @default(0)

  // One counter per menu, location and day — the upsert target.
  @@unique([menuId, locationId, day])
  // Reports read a location's days ("this week at this shop").
  @@index([locationId, day])
}

/**
 * "This customer already viewed this menu today" — the dedupe behind
 * MenuViewDaily.viewers, so opening the same menu ten times counts once.
 * `viewerKey` is a sha256 hex of the customer key — the Table
 * contributorToken or the Counter bill root (billSessionId ?? id) —
 * NEVER the raw token, so a leaked row can't be used as a session.
 * It holds no IP, device or personal data. Rows older than 90 days are
 * deleted (only today's rows matter for dedupe; the totals live on in
 * MenuViewDaily).
 */
model MenuViewSeen {
  id         Int      @id @default(autoincrement())
  // sha256 hex of the customer key, NEVER the raw token.
  viewerKey  String
  menu       Menu     @relation(fields: [menuId], references: [id])
  menuId     Int
  // Plain scalar, no relation: kept only to say which location's
  // counter the view went to — never joined, and pruned after 90 days.
  locationId Int
  // Shop day "YYYY-MM-DD" (lib/shopDay, Asia/Yangon).
  day        String
  createdAt  DateTime @default(now())

  // One row per customer, menu and day — a second view hits this and
  // counts nothing.
  @@unique([viewerKey, menuId, day])
  // The 90-day clean-up deletes by day.
  @@index([day])
}

enum ORDERSTATUS {
  CART
  PENDING_APPROVAL // Counter QR only — cashier approve/reject
  PENDING
  COOKING
  PAID
  COMPLETED
  CANCELLED
}

// Why a round ended CANCELLED — the DB can't otherwise tell these apart,
// since orderNumber is assigned at round creation, before any of these
// even become possible outcomes.
enum CancelReason {
  REJECTED // Cashier rejected a submitted round.
  EXPIRED // Submitted, but the approval window passed before a decision.
  UNSUBMITTED // A CART round that was never sent — abandoned, or closed at payment.
  WITHDRAWN // The customer cancelled their own round while it was waiting for approval.
}

// Why the cashier rejected a submitted round — OrderCancellation
// .rejectReason, REJECTED rows only.
enum RejectReason {
  OUT_OF_STOCK // An item in the round isn't actually available.
  SUSPECTED_FAKE // Looks fake — e.g. the customer isn't in the shop.
  CUSTOMER_REQUEST // The customer asked to cancel.
  OTHER // Anything else.
}
enum UserRole {
  ADMIN
  MANAGER
}

// What an owner can grant a MANAGER — one value per tickable box in
// Settings (lib/permissions.ts is the catalog: labels, groups, defaults).
// Only GRANTABLE permissions exist here: "take and manage orders" is
// always allowed for any signed-in staff and is never stored, and
// owner-only actions (locations, managers & permissions, company
// settings, menu setup, menu categories, add-on groups) can never be
// granted, so they have no value.
enum Permission {
  ORDERS_MARK_PAID // Mark a bill as paid (take money)
  MENU_AVAILABILITY // Turn menus on/off at their own location
  ADDON_AVAILABILITY // Turn add-on options on/off
  TABLES_MANAGE // Create/edit/delete tables, QR codes
  REPORTS_VIEW // Reports + CSV/PDF export
  ORDERS_VOID // Void items on an accepted, unpaid order. No default grant — the owner ticks it per manager.
}

/**
 * One permission an owner granted one MANAGER — a row means "allowed",
 * no row means "not allowed". ADMIN (owner) is never checked against
 * this table: an owner can do everything. Only grantable permissions are
 * stored (see Permission); a user's rows go with the user (Cascade), and
 * `grantedBy` is kept as history but cleared if that owner is deleted
 * (SetNull).
 */
model UserPermission {
  id          Int        @id @default(autoincrement())
  user        User       @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  permission  Permission
  grantedBy   User?      @relation("PermissionGrants", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedById Int?
  createdAt   DateTime   @default(now())

  @@unique([userId, permission])
  @@index([userId])
}
