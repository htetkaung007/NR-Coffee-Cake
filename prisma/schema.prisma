// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"

}

model User {
  id                 Int                @id @default(autoincrement())
  email              String             @unique
  name               String?
  password           String?
  role               UserRole           @default(ADMIN)
  company            Company            @relation(fields: [companyId], references: [id])
  selectedLocations  SelectedLocation[]
  companyId          Int
  location           Location?          @relation(fields: [locationId], references: [id])
  locationId         Int?
  createdAt          DateTime           @default(now())
  updateTime         DateTime           @updatedAt
  isArchived         Boolean            @default(false)
}

model Company {
  id             Int            @id @default(autoincrement())
  name           String
  address        String?
  users          User[]
  locations      Location[]
  menuCategories MenuCategory[]
  createdAt      DateTime       @default(now())
  updateTime     DateTime       @updatedAt
  isArchived     Boolean        @default(false)
}

model Table {
  id               Int            @id @default(autoincrement())
  name             String
  qrcodeImageUrl   String?        @default("")
  location         Location       @relation(fields: [locationId], references: [id])
  locationId       Int
  OrderSessions    OrderSession[]
  orders           Order[]
  // The key printed in this Counter's QR URL right now (e.g.
  // /counter?tableId=5&key=awzy) — checked once at scan time by
  // OrderSessionService.resolveCounterQrScan. Regenerating it (via
  // TableService.rotateCounterKey, which also reprints the QR image)
  // invalidates every previously-printed copy of this QR at once.
  // Only meaningful when isCounter is true; null for regular tables.
  counterAccessKey String?
  // Which OrderSession this table's QR currently resolves to — null
  // means the table is free for a brand-new order/group. Set by
  // TableDraftService.submitDraft the moment a round is created, and
  // left pointing at a now-terminal (PAID/COMPLETED/CANCELLED) session
  // until the next round supersedes it — see
  // OrderSessionService.getActiveRoundForTable, which treats a
  // terminal session behind this pointer the same as no active round.
  // Plain scalar, not a formal Prisma relation — OrderSessions above
  // already covers the Table<->OrderSession link via tableId, and a
  // second named relation here isn't needed since nothing navigates
  // table.activeSession directly (the Service looks it up by id).
  activeSessionId  Int?
  // Bumped by OrderSessionApprovalService.markSessionsPaid whenever
  // this table gets settled — see the per-customer draft design's
  // "invalidate old contributor tokens on payment" follow-up. Every
  // CONTRIBUTOR_TOKEN_COOKIE entry embeds the epoch it was minted
  // under (see contributorToken.ts); once this counter moves past
  // that, the token reads as stale even though the cookie itself is
  // still sitting in the customer's browser, forcing them back to
  // plain browsing until they scan the table's QR again (which always
  // mints a token under the table's CURRENT epoch). Table QR only —
  // Counter sessions never read this field, since each Counter phone
  // is already its own independent session with nothing to "reopen".
  contributorEpoch Int            @default(0)
  isCounter        Boolean?
  createdAt        DateTime       @default(now())
  updateTime       DateTime       @updatedAt
  isArchived       Boolean        @default(false)

  @@map("tables") // Avoids any issues with database reserved words
}

model Location {
  id                             Int                             @id @default(autoincrement())
  name                           String
  tables                         Table[]
  selectedLocations              SelectedLocation[]
  menuStocks                     MenuStock[]
   managers                       User[] 
  company                        Company                         @relation(fields: [companyId], references: [id])
  archivedAt                     DateTime?
  companyId                      Int
  createdAt                      DateTime                        @default(now())
  updateTime                     DateTime                        @updatedAt
  isArchived                     Boolean                         @default(false)
  disableLocationMenus           DisableLocationMenus[]
  disableLocationMenuCategories DisableLocationMenuCategories[]
  orderSessions                  OrderSession[]
  bills                          Bill[]
}

model SelectedLocation {
  id         Int      @id @default(autoincrement())
  location   Location @relation(fields: [locationId], references: [id])
  locationId Int
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  createdAt  DateTime @default(now())
  updateTime DateTime @updatedAt
  isArchived Boolean  @default(false)
  @@unique([userId])
}

model Menu {
  id                   Int                    @id @default(autoincrement())
  name                 String
  price                Int
  assetUrl             String?
  description          String?
  menuMenuCategory     MenuMenuCategory[]
  menuAddonCategories  MenuAddonCategories[]
  disableLocationMenus DisableLocationMenus[]
  menuStocks           MenuStock[]
  orders               Order[]
  createdAt            DateTime               @default(now())
  updateTime           DateTime               @updatedAt
  isArchived           Boolean                @default(false)
}
model MenuStock {
  id                 Int      @id @default(autoincrement())
  menu               Menu     @relation(fields: [menuId], references: [id])
  menuId             Int
  location           Location @relation(fields: [locationId], references: [id])
  locationId         Int
  quantity           Int      @default(0)
  isManuallyDisabled Boolean  @default(false)
  createdAt          DateTime @default(now())
  updateTime         DateTime @updatedAt
  isArchived         Boolean  @default(false)

  @@unique([menuId, locationId])
}

model MenuCategory {
  id                            Int                             @id @default(autoincrement())
  name                          String
  company                       Company                         @relation(fields: [companyId], references: [id])
  companyId                     Int
  menuMenuCategory              MenuMenuCategory[]
  disableLocationMenuCategories DisableLocationMenuCategories[]
  createdAt                     DateTime                        @default(now())
  updateTime                    DateTime                        @updatedAt
  isArchived                    Boolean                         @default(false)
}

// join Table
model MenuMenuCategory {
  id             Int          @id @default(autoincrement())
  menuCategory   MenuCategory @relation(fields: [menuCategoryId], references: [id])
  menuCategoryId Int
  menu           Menu         @relation(fields: [menuId], references: [id])
  menuId         Int
  createdAt      DateTime     @default(now())
  updateTime     DateTime     @updatedAt
  isArchived     Boolean      @default(false)
}

model Addon {
  id              Int             @id @default(autoincrement())
  name            String
  price           Int
  addonCategory   AddonCategories @relation(fields: [addonCategoryId], references: [id])
  addonCategoryId Int
  OrdersAddons    OrdersAddon[]
  isAvailable     Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updateTime      DateTime        @updatedAt
  isArchived      Boolean         @default(false)
}

model AddonCategories {
  id                Int                   @id @default(autoincrement())
  name              String
  isRequired        Boolean               @default(false)
  addons            Addon[]
  menuAddonCategory MenuAddonCategories[]
  createdAt         DateTime              @default(now())
  updateTime        DateTime              @updatedAt
  isArchived        Boolean               @default(false)
}

model MenuAddonCategories {
  id              Int             @id @default(autoincrement())
  menu            Menu            @relation(fields: [menuId], references: [id])
  menuId          Int
  addonCategory   AddonCategories @relation(fields: [addonCategoryId], references: [id])
  addonCategoryId Int
  createdAt       DateTime        @default(now())
  updateTime      DateTime        @updatedAt
  isArchived      Boolean         @default(false)
}

model DisableLocationMenus {
  id         Int      @id @default(autoincrement())
  locationId Int      @map("locationsId") // Keeps compatibility with your existing field naming
  location   Location @relation(fields: [locationId], references: [id])
  menu       Menu     @relation(fields: [menuId], references: [id])
  menuId     Int
  createdAt  DateTime @default(now())
  updateTime DateTime @updatedAt
  isArchived Boolean  @default(false)
}

model DisableLocationMenuCategories {
  id             Int          @id @default(autoincrement())
  locationId     Int          @map("locationsId") // Keeps compatibility with your existing field naming
  location       Location     @relation(fields: [locationId], references: [id])
  menuCategory   MenuCategory @relation(fields: [menuCategoryId], references: [id])
  menuCategoryId Int
  createdAt      DateTime     @default(now())
  updateTime     DateTime     @updatedAt
  isArchived     Boolean      @default(false)
}

model Order {
  id               Int           @id @default(autoincrement())
  menuId           Int
  quantity         Int
  // Snapshot of Menu.price at the moment this line was added — never
  // re-read from Menu for totals, since a later price change on the
  // menu must not alter an already-placed order's line total.
  unitPrice        Int
  tableId          Int
  // Nullable — a "draft" line item (see the Table-QR per-customer draft
  // design) has no session yet: it's owned by (tableId, contributorToken)
  // alone until "Send to Kitchen" merges same-menu/same-addon drafts and
  // attaches the merged rows to a freshly created OrderSession. A
  // Counter QR line item is never a draft — it gets orderSessionId set
  // immediately, same as before this change.
  orderSession     OrderSession? @relation(fields: [orderSessionId], references: [id])
  orderSessionId   Int?
  // Set only on draft (orderSessionId == null) rows — which customer's
  // phone added this line, so only they can edit/remove it before
  // Send to Kitchen (see the CONTRIBUTOR_TOKEN_COOKIE design). Left
  // null once merged into a session: after submit, editing is no
  // longer per-customer (the whole round is locked together), so
  // there's nothing left to check it against.
  contributorToken String?
  // Optional customer instruction for this one line item ("no onion",
  // "extra spicy") — item-level, not session-level. Null (never "")
  // when there's none. Drafts with different notes are deliberately
  // NOT merged by TableDraftService.submitDraft, so the note survives
  // Send to Kitchen.
  note             String?
  menu             Menu          @relation(fields: [menuId], references: [id])
  table            Table         @relation(fields: [tableId], references: [id])
  createdAt        DateTime      @default(now())
  updateTime       DateTime      @updatedAt
  isArchived       Boolean       @default(false)
  OrdersAddons     OrdersAddon[]

  // orderSessionId: serves every "lines of this session" read (Counter
  // cart, customer polling, Backoffice order list/detail, bill totals).
  // (tableId, orderSessionId): serves Table-QR draft reads, which filter
  // by table AND orderSessionId = null (getDraftItemsForTable,
  // submitDraft, the post-payment draft cleanup). tableId first so
  // table-only lookups can use it too. PostgreSQL does not auto-index
  // foreign keys, and this table keeps every line ever ordered.
  @@index([orderSessionId])
  @@index([tableId, orderSessionId])
  @@map("orders") // This fixes the Postgres "Order relation does not exist" issue by naming the table safely
}

// order id with addon id join table
model OrdersAddon {
  id        Int   @id @default(autoincrement())
  orderId   Int
  order     Order @relation(fields: [orderId], references: [id])
  addonId   Int
  addon     Addon @relation(fields: [addonId], references: [id])
  // Snapshot of Addon.price at the moment this line was added — never
  // re-read from Addon for totals, same reasoning as Order.unitPrice.
  unitPrice Int
}

/**
 * One receipt/order-group — ties multiple Order (line-item) rows
 * together into one customer-facing total, and is the one place
 * PAID/CANCELLED/etc. status is decided for the whole order.
 */
model OrderSession {
  id          Int         @id @default(autoincrement())
  // Opaque, unguessable identifier used as the cookie value for
  // Counter QR sessions — deliberately NOT the same as `id` (a plain
  // auto-increment int would let one customer's browser guess or
  // tamper into another customer's cookie/session by changing a
  // number). Table QR sessions don't need this since they're never
  // identified by a client-held credential in the first place.
  token       String      @unique @default(cuid())
  // Customer-facing label, e.g. "#A042". Generation scheme (daily-reset
  // vs global) still open — OrderSessionService.generateOrderNumber is
  // the one place to change it later.
  orderNumber String
  location    Location    @relation(fields: [locationId], references: [id])
  locationId  Int
  table       Table?      @relation(fields: [tableId], references: [id])
  tableId     Int?
  isCounter   Boolean     @default(false)
  status      ORDERSTATUS @default(CART)
  // Set the moment a customer submits from CART -> PENDING_APPROVAL;
  // cleared once a cashier accepts/rejects. OrderSessionService checks
  // this lazily on read (getSessionStatus) and in a batch sweep
  // (expireStaleApprovals) rather than needing a background job — any
  // session still PENDING_APPROVAL past this timestamp is treated as
  // timed out (5-minute window).
  approvalExpiresAt DateTime?
  orders      Order[]
  createdAt   DateTime    @default(now())
  updateTime  DateTime    @updatedAt
  isArchived  Boolean     @default(false)
  // Bill grouping for "Order More" rounds — null means this session IS
  // the first round of its own bill; otherwise this holds the id of
  // that bill's first round (the "root"), so round 3 points at round
  // 1, not round 2. Set only by OrderSessionService.startNextRound.
  // Plain scalar, same style as Table.activeSessionId — no formal
  // relation. Counter QR only for now. Grouping
  // (groupSessionsForDisplay) uses this numeric id, NEVER `token` — a
  // secret session credential that must never appear in a group key
  // or URL.
  billSessionId Int?
  // Set only once this round is paid — points at the immutable Bill
  // record created at payment time. Null for every open/unpaid round,
  // and distinct from billSessionId above (which groups open Counter
  // rounds before any payment happens).
  bill          Bill?       @relation(fields: [billId], references: [id])
  billId        Int?
  // Why this round was cancelled — set only together with status
  // CANCELLED (see OrderSessionService.cancelSession, the one place
  // that writes either). Null for every non-cancelled row, and for
  // CANCELLED rows written before this column existed (old data is
  // left as-is, never backfilled).
  cancelReason  CancelReason?

  @@index([billSessionId])
  @@index([billId])
  // Every Order page query filters by location first, then by status
  // (e.g. getSessionsForLocation's PENDING_APPROVAL/PENDING/COOKING,
  // and the pending-approval lookups). PostgreSQL does not auto-index
  // foreign keys, so without this those reads scan the whole table,
  // which keeps growing with PAID history. Column order matters:
  // locationId first, so location-only lookups can use it too.
  @@index([locationId, status])
}

/**
 * One row per PAID bill — created at payment time, grouping the one or
 * more OrderSession rounds (see OrderSession.billSessionId/billId) that
 * were settled together. A Bill is an immutable money record: once
 * written it is never updated, so it deliberately has no updateTime/
 * isArchived, and no tableId/isCounter — table and channel are derived
 * by following bill.sessions back to their OrderSession(s) instead of
 * being duplicated here.
 */
model Bill {
  id         Int            @id @default(autoincrement())
  // Display/search label — the first round's orderNumber.
  billNumber String
  location   Location       @relation(fields: [locationId], references: [id])
  // Filter key for history — kept on Bill on purpose (not derived via
  // sessions) so location-scoped bill history doesn't have to join out
  // to OrderSession just to filter by location.
  locationId Int
  // Snapshot of what was charged.
  total      Int
  paidAt     DateTime
  createdAt  DateTime       @default(now())
  sessions   OrderSession[]

  @@index([locationId, paidAt])
}

enum ORDERSTATUS {
  CART
  PENDING_APPROVAL // Counter QR only — cashier approve/reject
  PENDING
  COOKING
  PAID
  COMPLETED
  CANCELLED
}

// Why a round ended CANCELLED — the DB can't otherwise tell these apart,
// since orderNumber is assigned at round creation, before any of these
// even become possible outcomes.
enum CancelReason {
  REJECTED // Cashier rejected a submitted round.
  EXPIRED // Submitted, but the approval window passed before a decision.
  UNSUBMITTED // A CART round that was never sent — abandoned, or closed at payment.
}
enum UserRole {
  ADMIN
  MANAGER
}
