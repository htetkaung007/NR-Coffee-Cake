// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"

}

model User {
  id                 Int                @id @default(autoincrement())
  email              String             @unique
  name               String?
  password           String?
  company            Company            @relation(fields: [companyId], references: [id])
  selectedLocations  SelectedLocation[]
  companyId          Int
  createdAt          DateTime           @default(now())
  updateTime         DateTime           @updatedAt
  isArchived         Boolean            @default(false)
}

model Company {
  id             Int            @id @default(autoincrement())
  name           String
  address        String?
  users          User[]
  locations      Location[]
  menuCategories MenuCategory[]
  createdAt      DateTime       @default(now())
  updateTime     DateTime       @updatedAt
  isArchived     Boolean        @default(false)
}

model Table {
  id             Int       @id @default(autoincrement())
  name           String
  qrcodeImageUrl String?   @default("")
  location       Location  @relation(fields: [locationId], references: [id])
  locationId     Int
  orders         Order[]
  createdAt      DateTime  @default(now())
  updateTime     DateTime  @updatedAt
  isArchived     Boolean   @default(false)

  @@map("tables") // Avoids any issues with database reserved words
}

model Location {
  id                             Int                             @id @default(autoincrement())
  name                           String
  tables                         Table[]
  selectedLocations              SelectedLocation[]
  company                        Company                         @relation(fields: [companyId], references: [id])
  companyId                      Int
  createdAt                      DateTime                        @default(now())
  updateTime                     DateTime                        @updatedAt
  isArchived                     Boolean                         @default(false)
  disableLocationMenus           DisableLocationMenus[]
  disableLocationMenuCategories DisableLocationMenuCategories[]
}

model SelectedLocation {
  id         Int      @id @default(autoincrement())
  location   Location @relation(fields: [locationId], references: [id])
  locationId Int
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  createdAt  DateTime @default(now())
  updateTime DateTime @updatedAt
  isArchived Boolean  @default(false)
}

model Menu {
  id                   Int                    @id @default(autoincrement())
  name                 String
  price                Int
  assetUrl             String?
  menuMenuCategory     MenuMenuCategory[]
  menuAddonCategories  MenuAddonCategories[]
  disableLocationMenus DisableLocationMenus[]
  orders               Order[]
  createdAt            DateTime               @default(now())
  updateTime           DateTime               @updatedAt
  isArchived           Boolean                @default(false)
}

model MenuCategory {
  id                            Int                             @id @default(autoincrement())
  name                          String
  company                       Company                         @relation(fields: [companyId], references: [id])
  companyId                     Int
  menuMenuCategory              MenuMenuCategory[]
  disableLocationMenuCategories DisableLocationMenuCategories[]
  createdAt                     DateTime                        @default(now())
  updateTime                    DateTime                        @updatedAt
  isArchived                    Boolean                         @default(false)
}

// join Table
model MenuMenuCategory {
  id             Int          @id @default(autoincrement())
  menuCategory   MenuCategory @relation(fields: [menuCategoryId], references: [id])
  menuCategoryId Int
  menu           Menu         @relation(fields: [menuId], references: [id])
  menuId         Int
  createdAt      DateTime     @default(now())
  updateTime     DateTime     @updatedAt
  isArchived     Boolean      @default(false)
}

model Addon {
  id              Int             @id @default(autoincrement())
  name            String
  price           Int
  addonCategory   AddonCategories @relation(fields: [addonCategoryId], references: [id])
  addonCategoryId Int
  OrdersAddons    OrdersAddon[]
  isAvailable     Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updateTime      DateTime        @updatedAt
  isArchived      Boolean         @default(false)
}

model AddonCategories {
  id                Int                   @id @default(autoincrement())
  name              String
  isRequired        Boolean               @default(false)
  addons            Addon[]
  menuAddonCategory MenuAddonCategories[]
  createdAt         DateTime              @default(now())
  updateTime        DateTime              @updatedAt
  isArchived        Boolean               @default(false)
}

model MenuAddonCategories {
  id              Int             @id @default(autoincrement())
  menu            Menu            @relation(fields: [menuId], references: [id])
  menuId          Int
  addonCategory   AddonCategories @relation(fields: [addonCategoryId], references: [id])
  addonCategoryId Int
  createdAt       DateTime        @default(now())
  updateTime      DateTime        @updatedAt
  isArchived      Boolean         @default(false)
}

model DisableLocationMenus {
  id         Int      @id @default(autoincrement())
  locationId Int      @map("locationsId") // Keeps compatibility with your existing field naming
  location   Location @relation(fields: [locationId], references: [id])
  menu       Menu     @relation(fields: [menuId], references: [id])
  menuId     Int
  createdAt  DateTime @default(now())
  updateTime DateTime @updatedAt
  isArchived Boolean  @default(false)
}

model DisableLocationMenuCategories {
  id             Int          @id @default(autoincrement())
  locationId     Int          @map("locationsId") // Keeps compatibility with your existing field naming
  location       Location     @relation(fields: [locationId], references: [id])
  menuCategory   MenuCategory @relation(fields: [menuCategoryId], references: [id])
  menuCategoryId Int
  createdAt      DateTime     @default(now())
  updateTime     DateTime     @updatedAt
  isArchived     Boolean      @default(false)
}

model Order {
  id           Int           @id @default(autoincrement())
  menuId       Int
  quantity     Int
  tableId      Int
  status       ORDERSTATUS   @default(CART)
  menu         Menu          @relation(fields: [menuId], references: [id])
  table        Table         @relation(fields: [tableId], references: [id])
  createdAt    DateTime      @default(now())
  updateTime   DateTime      @updatedAt
  isArchived   Boolean       @default(false)
  OrdersAddons OrdersAddon[]

  @@map("orders") // This fixes the Postgres "Order relation does not exist" issue by naming the table safely
}

// order id with addon id join table
model OrdersAddon {
  id       Int   @id @default(autoincrement())
  orderId  Int
  order    Order @relation(fields: [orderId], references: [id])
  addonId  Int
  addon    Addon @relation(fields: [addonId], references: [id])
}

enum ORDERSTATUS {
  CART
  PENDING
  COOKING
  PAID
  COMPLETED
  CANCELLED
}