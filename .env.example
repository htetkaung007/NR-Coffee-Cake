# Every setting the app reads — names only. Copy to .env and fill in.
# Read through src/app/utils/config (CLAUDE.md §12); never commit .env.

# Database (Prisma) — the app's connection string.
DATABASE_URL=
# Database the Prisma CLI (migrate, generate) connects to — prisma.config.ts.
LOCAL_DATABASE_URL=

# NextAuth — the in-shop address (also printed in the table QR codes).
NEXTAUTH_URL=
# NextAuth — the secret that signs session cookies.
NEXTAUTH_SECRET=
# Google sign-in — OAuth client id.
GOOGLE_CLIENT_ID=
# Google sign-in — OAuth client secret.
GOOGLE_CLIENT_SECRET=

# Image storage — "local" (default: files under UPLOAD_DIR) or "s3".
STORAGE_PROVIDER=
# Local storage folder — optional in development (./.uploads), required and absolute in production.
UPLOAD_DIR=
# s3 only — the S3-compatible endpoint (MinIO, AWS S3, Spaces).
MINIO_ENDPOINT=
# s3 only — access key.
MINIO_ACCESS_KEY=
# s3 only — secret key.
MINIO_SECRET_KEY=
# s3 only — bucket name.
MINIO_BUCKET=

# The shop's IANA time zone for "today" and reports (default Asia/Yangon).
SHOP_TIMEZONE=
# Optional public address of the online menu (Settings shows the full link with it).
PUBLIC_BASE_URL=
